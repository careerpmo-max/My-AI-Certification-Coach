# My AI Certification Coach — environment variables (reference)
#
# IMPORTANT: the app has NO dotenv loader and does not read .env on its own.
# Variables are read from the process environment (src/server/config.js, src/server/openai.js, scripts/*.mjs).
# To use a .env file with Node 22+, start the server with:
#   node --env-file=.env src/server/index.js
# (`npm start` does not load .env.)
#
# Optional variables are commented out: an empty value would override the built-in default
# (e.g. COACH_PORT= would be read as port 0). Uncomment only the ones you want to change.

# OpenAI API key. Used ONLY by `npm run doctor`.
# The app itself takes the key from the onboarding screen and stores it in data/secrets.json.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Local HTTP port (default: 3210). The server always binds to 127.0.0.1.
# COACH_PORT=

# Folder holding local data: profile, API key, curricula, sessions (default: ./data).
# COACH_DATA_DIR=

# Model for coaching, diagnostic, plan and quizzes (default: gpt-4.1).
# COACH_TEXT_MODEL=

# Model for extracting the exam outline from the official page (default: gpt-4.1-mini).
# COACH_EXTRACT_MODEL=

# Model for web-search research (default: gpt-4.1).
# COACH_RESEARCH_MODEL=

# JSON override of the indicative pricing used by the usage counter (see src/server/config.js).
# COACH_PRICING=

# Alternative OpenAI-compatible API base URL (default: https://api.openai.com/v1).
# COACH_OPENAI_BASE=

# Set to 1 to skip the automatic desktop shortcut created at first launch.
# COACH_NO_SHORTCUT=
